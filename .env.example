# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SGAJJ Security & External Channels (optional overrides; safe cryptographic defaults apply locally if omitted)
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"
DATA_ENCRYPTION_KEY="CHANGE_ME_32_BYTE_SECRET"
SMS_WEBHOOK_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="AJJ Angola"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="no-reply@ajj-angola.org"
EMAIL_FROM_NAME="SGAJJ — Associação de Jovens Juristas"

# Supabase Hosted PostgreSQL & Storage (server-side only; configure via Secrets)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="sgajj-documentos"

